<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+: nothing from this app is copied to a cloud backup or to a
  new phone. The wrapped master key only works with this phone's Keystore
  key, which is never exported, so a restored copy would be unreadable
  anyway, and a backup is exactly where an abuser with access to the
  survivor's Google account would look.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
